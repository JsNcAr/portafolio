---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/PageHeader.astro';
import TechPill from '@components/TechPill.astro';
import Period from '@components/Period.astro';
import type { Locale } from '@i18n/ui';
import { useTranslations, localePath } from '@i18n/utils';
import { getCollection } from 'astro:content';
import Icon from '@components/Icon.astro';
import { period } from '@lib/format';
import { roles } from '@data/cv';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

// Only roles with a case study in this locale get a link.
const studies = new Set(
  (await getCollection('work'))
    .filter((entry) => entry.id.startsWith(`${locale}/`))
    .map((entry) => entry.data.role),
);
---

<Base locale={locale} path="/work" title={t('work.title')} description={t('work.intro')}>
  <PageHeader overline={t('site.role')} title={t('work.lead')} intro={t('work.intro')} />

  <div class="shell">
    <ol class="roles">
      {roles.map((role) => (
        <li class:list={['role', { current: role.end === null }]} id={role.id}>
          <div class="meta">
            <Period start={role.start} end={role.end} locale={locale} class="overline" />
            {role.end === null && <p class="badge">{t('work.role.current')}</p>}
            <p class="place">{role.location}</p>
          </div>

          <div class="body">
            <h2>{role.org}</h2>
            <p class="title">{role.title}</p>
            <p class="summary">{role.summary[locale]}</p>

            {role.highlights.length > 0 && (
              <ul class="highlights">
                {role.highlights.map((h) => <li>{h[locale]}</li>)}
              </ul>
            )}

            {role.stack.length > 0 && (
              <ul class="pills">
                {role.stack.map((item) => <TechPill label={item} />)}
              </ul>
            )}

            {studies.has(role.id as never) && (
              <p class="cs">
                <a href={localePath(locale, `/work/${role.id}`)}>
                  {t('cs.read')}
                  <Icon name="arrow-right" size={16} />
                </a>
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .roles {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-64);
  }

  .role {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-40);
    border-block-end: var(--stroke-hairline) solid var(--color-border-default);
    min-inline-size: 0;
  }

  .role:last-child {
    border-block-end: 0;
  }

  /* The current role is the one differentiator in an otherwise even list. */
  .role.current {
    border-inline-start: var(--stroke-rule) solid var(--color-action-primary);
    padding-inline-start: var(--space-24);
    margin-inline-start: calc(-1 * var(--space-24));
  }

  @media (min-width: 56rem) {
    .role {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-32);
    }
  }

  .meta {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  .badge {
    justify-self: start;
    padding: var(--space-2) var(--space-8);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-feedback-info-text);
    background: var(--color-feedback-info-bg);
    border: var(--stroke-hairline) solid var(--color-feedback-info-border);
    border-radius: var(--radius-sm);
  }

  .place {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
  }

  .body {
    min-inline-size: 0;
  }

  h2 {
    font-size: var(--text-2xl);
  }

  .title {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-accent);
  }

  .summary {
    margin-block-start: var(--space-12);
    color: var(--color-text-secondary);
    max-inline-size: var(--measure-prose);
  }

  .highlights {
    margin-block-start: var(--space-16);
    padding-inline-start: var(--space-20);
    max-inline-size: var(--measure-prose);
    display: grid;
    gap: var(--space-10);
    color: var(--color-text-secondary);
  }

  .highlights li::marker {
    color: var(--color-text-tertiary);
  }

  .cs {
    margin-block-start: var(--space-20);
  }

  .cs a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-block-size: var(--space-44);
    padding: var(--space-8) var(--space-16);
    border: var(--stroke-thin) solid var(--color-border-strong);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .cs a:hover {
    background: var(--color-action-secondary-hover);
  }

  .cs a:active {
    background: var(--color-action-secondary-active);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-20);
    min-inline-size: 0;
  }
</style>
