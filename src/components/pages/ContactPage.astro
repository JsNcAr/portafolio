---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/PageHeader.astro';
import Icon from '@components/Icon.astro';
import type { Locale } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import { contact } from '@data/cv';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const CV = '/cv/jason-arias-python-backend-engineer.pdf';

const methods = [
  { label: t('contact.email.label'), value: contact.email, href: `mailto:${contact.email}`, icon: 'mail' as const },
  { label: t('contact.github.label'), value: 'github.com/JsNcAr', href: contact.github, icon: 'github' as const },
  { label: t('contact.linkedin.label'), value: contact.linkedin.replace('https://', ''), href: contact.linkedin, icon: 'linkedin' as const },
];
---

<Base locale={locale} path="/contact" title={t('contact.title')} description={t('contact.intro')}>
  <PageHeader overline={t('contact.title')} title={t('contact.lead')} intro={t('contact.intro')} />

  <div class="shell">
    <dl class="methods">
      {methods.map((m) => (
        <div class="method">
          <dt>{m.label}</dt>
          <dd>
            <a href={m.href} rel={m.href.startsWith('mailto:') ? undefined : 'me noopener'} target={m.href.startsWith('mailto:') ? undefined : '_blank'}>
              <Icon name={m.icon} size={16} />
              <span>{m.value}</span>
              {!m.href.startsWith('mailto:') && <Icon name="arrow-up-right" size={14} />}
            </a>
          </dd>
        </div>
      ))}
      <div class="method">
        <dt>{t('contact.location.label')}</dt>
        <dd class="plain">
          <Icon name="map-pin" size={16} />
          <span>{contact.location[locale]}</span>
        </dd>
      </div>
    </dl>

    <section class="cv" aria-labelledby="cv-heading">
      <div>
        <h2 id="cv-heading">{t('contact.cv.title')}</h2>
        <p>{t('contact.cv.body')}</p>
      </div>
      <p>
        <a class="btn" href={CV} download>
          {t('contact.cv.download')}
          <Icon name="arrow-right" size={16} />
        </a>
      </p>
    </section>
  </div>
</Base>

<style>
  .methods {
    margin: var(--space-48) 0 0;
    display: grid;
    gap: var(--space-20);
  }

  .method {
    display: grid;
    gap: var(--space-4);
    padding-block-end: var(--space-20);
    border-block-end: var(--stroke-hairline) solid var(--color-border-default);
    min-inline-size: 0;
  }

  @media (min-width: 48rem) {
    .method {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-24);
      align-items: baseline;
    }
  }

  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  dd {
    margin: 0;
    min-inline-size: 0;
  }

  dd a,
  dd.plain {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-block-size: var(--space-36);
    font-size: var(--text-lg);
    min-inline-size: 0;
  }

  dd.plain {
    color: var(--color-text-secondary);
  }

  .cv {
    display: grid;
    gap: var(--space-20);
    margin-block: var(--space-48) var(--space-80);
    padding: var(--space-32);
    background: var(--color-surface-sunken);
    border: var(--stroke-hairline) solid var(--color-border-default);
    border-radius: var(--radius-md);
  }

  @media (min-width: 48rem) {
    .cv {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-40);
    }
  }

  .cv h2 {
    font-size: var(--text-xl);
  }

  .cv p {
    margin-block-start: var(--space-6);
    color: var(--color-text-secondary);
    max-inline-size: var(--measure-prose);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-block-size: var(--space-44);
    padding: var(--space-10) var(--space-20);
    border-radius: var(--radius-md);
    background: var(--color-action-primary);
    color: var(--color-text-on-action);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    border: var(--stroke-thin) solid transparent;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .btn:hover {
    background: var(--color-action-primary-hover);
  }

  .btn:active {
    background: var(--color-action-primary-active);
  }
</style>
