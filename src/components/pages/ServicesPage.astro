---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/PageHeader.astro';
import ServiceCard from '@components/ServiceCard.astro';
import TechPill from '@components/TechPill.astro';
import Icon from '@components/Icon.astro';
import Flow from '@components/diagrams/Flow.astro';
import { formatPrice } from '@lib/price';
import type { Locale } from '@i18n/ui';
import { useTranslations, localePath } from '@i18n/utils';
import { services, websites, classSubjects, classFormats, classAudiences } from '@data/services';
import { whatsappLink } from '@lib/whatsapp';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const engineering = services.filter((s) => s.group === 'engineering');
const lead = engineering.find((s) => s.lead)!;
const rest = engineering.filter((s) => !s.lead);

const build = formatPrice(websites.build, locale);
const hosting = formatPrice(websites.hosting, locale);

const steps = [
  { label: t('svc.how.1'), note: t('svc.how.1.note') },
  { label: t('svc.how.2'), note: t('svc.how.2.note'), accent: true },
  { label: t('svc.how.3'), note: t('svc.how.3.note') },
];
---

<Base locale={locale} path="/services" title={t('svc.title')} description={t('svc.intro')}>
  <PageHeader overline={t('svc.title')} title={t('svc.lead')} intro={t('svc.intro')} />

  <section class="shell block" aria-labelledby="engineering">
    <div class="section-head">
      <h2 class="overline" id="engineering">{t('svc.engineering')}</h2>
      <p>{t('svc.engineering.note')}</p>
    </div>

    <ul class="grid">
      <ServiceCard service={lead} locale={locale} />
      {rest.map((service) => <ServiceCard service={service} locale={locale} />)}
    </ul>
  </section>

  <section class="shell block" aria-labelledby="how">
    <h2 class="overline" id="how">{t('svc.how')}</h2>
    <Flow steps={steps} caption={t('svc.how.caption')} />
  </section>

  <section class="sites" aria-labelledby="sites">
    <div class="shell">
      <h2 class="overline" id="sites">{t('svc.sites')}</h2>
      <p class="sites-lead">{t('svc.sites.lead')}</p>
      <p class="sites-blurb">{websites.blurb[locale]}</p>

      <ul class="pills">
        {websites.stack.map((item) => <TechPill label={item} />)}
      </ul>

      <div class="two-prices">
        {build && (
          <div class="tier">
            <p class="tier-name">{t('svc.sites.build')}</p>
            <p class="tier-price">
              <span class="from">{t('svc.from')}</span>
              <span class="amount">{build.amount}</span>
              <span class="unit">{build.unit}</span>
            </p>
          </div>
        )}
        {hosting && (
          <div class="tier">
            <p class="tier-name">{t('svc.sites.hosting')}</p>
            <p class="tier-price">
              <span class="from">{t('svc.from')}</span>
              <span class="amount">{hosting.amount}</span>
              <span class="unit">{hosting.unit}</span>
            </p>
          </div>
        )}
      </div>

      <div class="examples">
        <p class="overline">{t('svc.sites.examples')}</p>
        <ul>
          {websites.examples.map((site) => (
            <li>
              <a href={site.url} rel="noopener" target="_blank">
                <span class="stretch"></span>
                <span class="site-name">{site.name}</span>
                <Icon name="arrow-up-right" size={14} />
              </a>
              <p class="site-note">{site.note[locale]}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="classes" aria-labelledby="classes">
    <div class="shell">
      <h2 class="overline" id="classes">{t('svc.classes')}</h2>
      <p class="classes-lead">{t('svc.classes.lead')}</p>
      <p class="classes-intro">{t('svc.classes.intro')}</p>

      <dl class="rows">
        <div class="row">
          <dt>{t('svc.classes.subjects')}</dt>
          <dd>
            <ul class="subjects">
              {classSubjects.map((subject) => <li>{subject[locale]}</li>)}
            </ul>
          </dd>
        </div>

        <div class="row">
          <dt>{t('svc.classes.formats')}</dt>
          <dd>
            <ul class="formats">
              {classFormats.map((format) => {
                const price = formatPrice(format.price, locale);
                return (
                  <li>
                    <p class="fmt-title">{format.title[locale]}</p>
                    <p class="fmt-note">{format.note[locale]}</p>
                    {price && (
                      <p class="fmt-price">
                        <span class="from">{t('svc.from')}</span>
                        <span class="amount">{price.amount}</span>
                        <span class="unit">{price.unit}</span>
                      </p>
                    )}
                  </li>
                );
              })}
            </ul>
          </dd>
        </div>

        <div class="row">
          <dt>{t('svc.classes.who')}</dt>
          <dd>
            <ul class="who">
              {classAudiences.map((audience) => (
                <li>
                  <p class="who-label">{audience.label[locale]}</p>
                  <p class="who-note">{audience.note[locale]}</p>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>

      <p class="classes-cta">
        <a
          class="btn btn-primary"
          href={whatsappLink(t('svc.classes.whatsapp.prefill'))}
          rel="noopener"
          target="_blank"
        >
          <Icon name="whatsapp" size={16} />
          {t('svc.classes.book')}
        </a>
      </p>
    </div>
  </section>

  <section class="shell block" aria-labelledby="contracting">
    <h2 class="overline" id="contracting">{t('svc.contracting')}</h2>
    <p class="contracting">{t('svc.contracting.body')}</p>
  </section>

  <section class="shell cta" aria-labelledby="cta">
    <div>
      <h2 id="cta">{t('svc.cta.title')}</h2>
      <p>{t('svc.cta.body')}</p>
    </div>
    <p class="cta-actions">
      <a
        class="btn btn-primary"
        href={whatsappLink(t('svc.whatsapp.prefill'))}
        rel="noopener"
        target="_blank"
      >
        <Icon name="whatsapp" size={16} />
        {t('svc.whatsapp')}
      </a>
      <a class="btn btn-secondary" href={localePath(locale, '/contact')}>
        {t('svc.enquire')}
        <Icon name="arrow-right" size={16} />
      </a>
    </p>
  </section>
</Base>

<style>
  .block {
    padding-block: var(--space-48);
  }

  .section-head {
    display: grid;
    gap: var(--space-6);
    margin-block-end: var(--space-24);
  }

  .section-head p {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    gap: var(--space-16);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Lead full width, then wide / narrow -- the rhythm already used on the open
     source page. Four equal cards read as a generated grid. */
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .grid > :global(.service) {
      grid-column: span 5;
    }

    .grid > :global(.service:nth-child(2)) {
      grid-column: span 3;
    }

    .grid > :global(.service:nth-child(3)) {
      grid-column: span 2;
    }
  }

  /* Websites are the one offer with live work to point at, so the examples are
     the section rather than a footnote. */
  .sites {
    padding-block: var(--space-56);
    border-block-start: var(--stroke-hairline) solid var(--color-border-default);
  }

  .sites-lead {
    margin-block-start: var(--space-12);
    font-size: var(--text-3xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    max-inline-size: 22ch;
    text-wrap: balance;
  }

  .sites-blurb {
    margin-block-start: var(--space-16);
    max-inline-size: var(--measure-prose);
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin: var(--space-20) 0 0;
    min-inline-size: 0;
  }

  .two-prices {
    display: grid;
    gap: var(--space-16);
    margin-block-start: var(--space-32);
  }

  @media (min-width: 44rem) {
    .two-prices {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-24);
    }
  }

  .tier {
    padding: var(--space-20);
    background: var(--color-surface-accent);
    border: var(--stroke-hairline) solid var(--color-border-accent);
    border-radius: var(--radius-md);
    min-inline-size: 0;
  }

  .tier-name {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .tier-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-6);
    margin-block-start: var(--space-8);
    font-variant-numeric: tabular-nums;
    min-inline-size: 0;
  }

  .tier-price .amount {
    font-size: var(--text-2xl);
  }

  .examples {
    margin-block-start: var(--space-40);
    padding-block-start: var(--space-24);
    border-block-start: var(--stroke-hairline) solid var(--color-border-default);
  }

  .examples ul {
    display: grid;
    gap: var(--space-16);
    list-style: none;
    padding: 0;
    margin: var(--space-16) 0 0;
  }

  @media (min-width: 44rem) {
    .examples ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-20);
    }
  }

  .examples li {
    position: relative;
    padding: var(--space-20);
    background: var(--color-surface-card);
    border: var(--stroke-hairline) solid var(--color-border-default);
    border-radius: var(--radius-md);
    min-inline-size: 0;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .examples li:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }

  /* Stretched link: the ring belongs on the card, not on the text. */
  .examples li:has(a:focus-visible) {
    box-shadow: var(--shadow-focus-ring);
  }

  .stretch {
    position: absolute;
    inset: 0;
  }

  .examples a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    min-block-size: var(--space-28);
    text-decoration: none;
  }

  .examples a:focus-visible {
    outline: none;
  }

  .examples li:hover .site-name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-name {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
    overflow-wrap: anywhere;
  }

  .site-note {
    margin-block-start: var(--space-6);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  /* Teaching is a different kind of offer, so it gets a different treatment and
     its own ground rather than four more cards. */
  .classes {
    padding-block: var(--space-56);
    background: var(--color-surface-sunken);
    border-block: var(--stroke-hairline) solid var(--color-border-default);
  }

  /* Display type, so it needs the tight leading. Without this it inherits the
     body's --leading-relaxed and the three lines drift apart. */
  .classes-lead {
    margin-block-start: var(--space-12);
    font-size: var(--text-3xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    max-inline-size: 20ch;
    text-wrap: balance;
  }

  .classes-intro {
    margin-block-start: var(--space-16);
    max-inline-size: var(--measure-prose);
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  .rows {
    display: grid;
    gap: var(--space-32);
    margin: var(--space-40) 0 0;
  }

  .row {
    display: grid;
    gap: var(--space-12);
    min-inline-size: 0;
    padding-block-end: var(--space-32);
    border-block-end: var(--stroke-hairline) solid var(--color-border-default);
  }

  .row:last-child {
    padding-block-end: 0;
    border-block-end: 0;
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-24);
    }
  }

  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  dd {
    margin: 0;
    min-inline-size: 0;
  }

  .subjects {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-16);
    list-style: none;
    padding: 0;
    margin: 0;
    min-inline-size: 0;
  }

  .subjects li {
    font-weight: var(--weight-medium);
  }

  .formats,
  .who {
    display: grid;
    gap: var(--space-20);
    list-style: none;
    padding: 0;
    margin: 0;
    min-inline-size: 0;
  }

  @media (min-width: 56rem) {
    .who {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-24) var(--space-32);
    }
  }

  .fmt-title,
  .who-label {
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  .fmt-note,
  .who-note {
    margin-block-start: var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    max-inline-size: var(--measure-prose);
  }

  .fmt-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-6);
    margin-block-start: var(--space-8);
    font-variant-numeric: tabular-nums;
  }

  .from {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .amount {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .unit {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .contracting {
    margin-block-start: var(--space-12);
    max-inline-size: var(--measure-prose);
    color: var(--color-text-secondary);
  }

  .cta {
    display: grid;
    gap: var(--space-20);
    margin-block-end: var(--space-80);
    padding: var(--space-32);
    background: var(--color-surface-card);
    border: var(--stroke-hairline) solid var(--color-border-default);
    border-radius: var(--radius-md);
  }

  @media (min-width: 48rem) {
    .cta {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-40);
    }
  }

  .cta h2 {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
  }

  .cta > div p {
    margin-block-start: var(--space-8);
    color: var(--color-text-secondary);
    max-inline-size: var(--measure-prose);
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    min-inline-size: 0;
  }

  .classes-cta {
    margin-block-start: var(--space-40);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-block-size: var(--space-44);
    padding: var(--space-10) var(--space-20);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    border: var(--stroke-thin) solid transparent;
    min-inline-size: 0;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .btn-primary {
    background: var(--color-action-primary);
    color: var(--color-text-on-action);
  }

  .btn-primary:hover {
    background: var(--color-action-primary-hover);
  }

  .btn-primary:active {
    background: var(--color-action-primary-active);
  }

  /* Secondary is neutral: outline and dark text, never a coloured fill. */
  .btn-secondary {
    background: transparent;
    color: var(--color-text-primary);
    border-color: var(--color-border-strong);
  }

  .btn-secondary:hover {
    background: var(--color-action-secondary-hover);
  }

  .btn-secondary:active {
    background: var(--color-action-secondary-active);
  }
</style>
