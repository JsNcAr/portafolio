---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/PageHeader.astro';
import ServiceCard from '@components/ServiceCard.astro';
import Icon from '@components/Icon.astro';
import Flow from '@components/diagrams/Flow.astro';
import { formatPrice } from '@lib/price';
import type { Locale } from '@i18n/ui';
import { useTranslations, localePath } from '@i18n/utils';
import { services, classSubjects, classFormats, classAudiences } from '@data/services';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const engineering = services.filter((s) => s.group === 'engineering');
const lead = engineering.find((s) => s.lead)!;
const rest = engineering.filter((s) => !s.lead);

const steps = [
  { label: t('svc.how.1'), note: t('svc.how.1.note') },
  { label: t('svc.how.2'), note: t('svc.how.2.note'), accent: true },
  { label: t('svc.how.3'), note: t('svc.how.3.note') },
];
---

<Base locale={locale} path="/services" title={t('svc.title')} description={t('svc.intro')}>
  <PageHeader overline={t('svc.title')} title={t('svc.lead')} intro={t('svc.intro')} />

  <section class="shell block" aria-labelledby="engineering">
    <div class="section-head">
      <h2 class="overline" id="engineering">{t('svc.engineering')}</h2>
      <p>{t('svc.engineering.note')}</p>
    </div>

    <ul class="grid">
      <ServiceCard service={lead} locale={locale} />
      {rest.map((service) => <ServiceCard service={service} locale={locale} />)}
    </ul>
  </section>

  <section class="shell block" aria-labelledby="how">
    <h2 class="overline" id="how">{t('svc.how')}</h2>
    <Flow steps={steps} caption={t('svc.how.caption')} />
  </section>

  <section class="classes" aria-labelledby="classes">
    <div class="shell">
      <h2 class="overline" id="classes">{t('svc.classes')}</h2>
      <p class="classes-lead">{t('svc.classes.lead')}</p>
      <p class="classes-intro">{t('svc.classes.intro')}</p>

      <dl class="rows">
        <div class="row">
          <dt>{t('svc.classes.subjects')}</dt>
          <dd>
            <ul class="subjects">
              {classSubjects.map((subject) => <li>{subject[locale]}</li>)}
            </ul>
          </dd>
        </div>

        <div class="row">
          <dt>{t('svc.classes.formats')}</dt>
          <dd>
            <ul class="formats">
              {classFormats.map((format) => {
                const price = formatPrice(format.price, locale);
                return (
                  <li>
                    <p class="fmt-title">{format.title[locale]}</p>
                    <p class="fmt-note">{format.note[locale]}</p>
                    {price && (
                      <p class="fmt-price">
                        <span class="from">{t('svc.from')}</span>
                        <span class="amount">{price.amount}</span>
                        <span class="unit">{price.unit}</span>
                      </p>
                    )}
                  </li>
                );
              })}
            </ul>
          </dd>
        </div>

        <div class="row">
          <dt>{t('svc.classes.who')}</dt>
          <dd>
            <ul class="who">
              {classAudiences.map((audience) => (
                <li>
                  <p class="who-label">{audience.label[locale]}</p>
                  <p class="who-note">{audience.note[locale]}</p>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="shell block" aria-labelledby="contracting">
    <h2 class="overline" id="contracting">{t('svc.contracting')}</h2>
    <p class="contracting">{t('svc.contracting.body')}</p>
  </section>

  <section class="shell cta" aria-labelledby="cta">
    <div>
      <h2 id="cta">{t('svc.cta.title')}</h2>
      <p>{t('svc.cta.body')}</p>
    </div>
    <p>
      <a class="btn" href={localePath(locale, '/contact')}>
        {t('svc.enquire')}
        <Icon name="arrow-right" size={16} />
      </a>
    </p>
  </section>
</Base>

<style>
  .block {
    padding-block: var(--space-48);
  }

  .section-head {
    display: grid;
    gap: var(--space-6);
    margin-block-end: var(--space-24);
  }

  .section-head p {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    gap: var(--space-16);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Lead full width, then wide / narrow -- the rhythm already used on the open
     source page. Four equal cards read as a generated grid. */
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .grid > :global(.service) {
      grid-column: span 5;
    }

    .grid > :global(.service:nth-child(2)) {
      grid-column: span 3;
    }

    .grid > :global(.service:nth-child(3)) {
      grid-column: span 2;
    }
  }

  /* Teaching is a different kind of offer, so it gets a different treatment and
     its own ground rather than four more cards. */
  .classes {
    padding-block: var(--space-56);
    background: var(--color-surface-sunken);
    border-block: var(--stroke-hairline) solid var(--color-border-default);
  }

  /* Display type, so it needs the tight leading. Without this it inherits the
     body's --leading-relaxed and the three lines drift apart. */
  .classes-lead {
    margin-block-start: var(--space-12);
    font-size: var(--text-3xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
    max-inline-size: 20ch;
    text-wrap: balance;
  }

  .classes-intro {
    margin-block-start: var(--space-16);
    max-inline-size: var(--measure-prose);
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  .rows {
    display: grid;
    gap: var(--space-32);
    margin: var(--space-40) 0 0;
  }

  .row {
    display: grid;
    gap: var(--space-12);
    min-inline-size: 0;
    padding-block-end: var(--space-32);
    border-block-end: var(--stroke-hairline) solid var(--color-border-default);
  }

  .row:last-child {
    padding-block-end: 0;
    border-block-end: 0;
  }

  @media (min-width: 48rem) {
    .row {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-24);
    }
  }

  dt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  dd {
    margin: 0;
    min-inline-size: 0;
  }

  .subjects {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6) var(--space-16);
    list-style: none;
    padding: 0;
    margin: 0;
    min-inline-size: 0;
  }

  .subjects li {
    font-weight: var(--weight-medium);
  }

  .formats,
  .who {
    display: grid;
    gap: var(--space-20);
    list-style: none;
    padding: 0;
    margin: 0;
    min-inline-size: 0;
  }

  @media (min-width: 56rem) {
    .who {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-24) var(--space-32);
    }
  }

  .fmt-title,
  .who-label {
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  .fmt-note,
  .who-note {
    margin-block-start: var(--space-4);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    max-inline-size: var(--measure-prose);
  }

  .fmt-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-6);
    margin-block-start: var(--space-8);
    font-variant-numeric: tabular-nums;
  }

  .from {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-overline);
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .amount {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
  }

  .unit {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .contracting {
    margin-block-start: var(--space-12);
    max-inline-size: var(--measure-prose);
    color: var(--color-text-secondary);
  }

  .cta {
    display: grid;
    gap: var(--space-20);
    margin-block-end: var(--space-80);
    padding: var(--space-32);
    background: var(--color-surface-card);
    border: var(--stroke-hairline) solid var(--color-border-default);
    border-radius: var(--radius-md);
  }

  @media (min-width: 48rem) {
    .cta {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-40);
    }
  }

  .cta h2 {
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
  }

  .cta > div p {
    margin-block-start: var(--space-8);
    color: var(--color-text-secondary);
    max-inline-size: var(--measure-prose);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-block-size: var(--space-44);
    padding: var(--space-10) var(--space-20);
    border-radius: var(--radius-md);
    background: var(--color-action-primary);
    color: var(--color-text-on-action);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    border: var(--stroke-thin) solid transparent;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .btn:hover {
    background: var(--color-action-primary-hover);
  }

  .btn:active {
    background: var(--color-action-primary-active);
  }
</style>
