---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/PageHeader.astro';
import type { Locale } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import { period } from '@lib/format';
import { roles, education, certifications } from '@data/cv';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const languages = [t('about.lang.es'), t('about.lang.en'), t('about.lang.ja')];
---

<Base locale={locale} path="/about" title={t('about.title')} description={t('about.lead')}>
  <PageHeader overline={t('about.title')} title={t('about.lead')} />

  <div class="shell">
    <div class="prose body">
      <p>{t('about.body.a')}</p>
      <p>{t('about.body.b')}</p>
      <p>{t('about.body.c')}</p>
      <p>{t('about.body.d')}</p>
    </div>

    <section class="block" aria-labelledby="timeline">
      <h2 class="overline" id="timeline">{t('about.timeline')}</h2>
      <ol class="timeline">
        {roles.map((role) => (
          <li>
            <p class="when">{period(role.start, role.end, locale, t('work.present'))}</p>
            <div>
              <p class="what">
                <strong>{role.title}</strong> — {role.org}
              </p>
              <p class="where">{role.location}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="block" aria-labelledby="education">
      <h2 class="overline" id="education">{t('about.education')}</h2>
      <div class="edu">
        <p class="when">{education.start} — {t('work.present')}</p>
        <div>
          <p class="what">
            <strong>{education.degree}</strong> — {education.org}
          </p>
          <p class="note">{education.note[locale]}</p>
        </div>
      </div>
    </section>

    <div class="two-up">
      <section aria-labelledby="certs">
        <h2 class="overline" id="certs">{t('about.certifications')}</h2>
        <ul class="plain">
          {certifications.map((cert) => <li>{cert}</li>)}
        </ul>
      </section>

      <section aria-labelledby="langs">
        <h2 class="overline" id="langs">{t('about.languages')}</h2>
        <ul class="plain">
          {languages.map((lang) => <li>{lang}</li>)}
        </ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .body {
    padding-block-start: var(--space-40);
    display: grid;
    gap: var(--space-16);
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .body p:first-child {
    color: var(--color-text-primary);
  }

  .block {
    margin-block-start: var(--space-56);
    padding-block-start: var(--space-24);
    border-block-start: var(--stroke-hairline) solid var(--color-border-default);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-16);
    display: grid;
    gap: var(--space-16);
  }

  .timeline li,
  .edu {
    display: grid;
    gap: var(--space-4);
    min-inline-size: 0;
  }

  @media (min-width: 48rem) {
    .timeline li,
    .edu {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-24);
      align-items: baseline;
    }
  }

  .edu {
    margin-block-start: var(--space-16);
  }

  .when {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-tertiary);
  }

  .what {
    color: var(--color-text-primary);
  }

  .where,
  .note {
    margin-block-start: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    max-inline-size: var(--measure-prose);
  }

  .two-up {
    display: grid;
    gap: var(--space-32);
    margin-block-start: var(--space-56);
    padding-block-start: var(--space-24);
    border-block-start: var(--stroke-hairline) solid var(--color-border-default);
  }

  @media (min-width: 48rem) {
    .two-up {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-48);
    }
  }

  .plain {
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-16);
    display: grid;
    gap: var(--space-10);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    max-inline-size: var(--measure-prose);
  }
</style>
