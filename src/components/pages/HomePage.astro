---
import Base from '@layouts/Base.astro';
import CaseCard from '@components/CaseCard.astro';
import TechPill from '@components/TechPill.astro';
import Icon from '@components/Icon.astro';
import type { Locale } from '@i18n/ui';
import { useTranslations, localePath } from '@i18n/utils';
import { roles, skills, contact } from '@data/cv';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const MONTHS: Record<Locale, string[]> = {
  en: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
  es: ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'],
};
const PRESENT: Record<Locale, string> = { en: 'Present', es: 'Actualidad' };

function month(value: string): string {
  const [year, mm] = value.split('-');
  return `${MONTHS[locale][Number(mm) - 1]} ${year}`;
}

function period(start: string, end: string | null): string {
  return `${month(start)} — ${end ? month(end) : PRESENT[locale]}`;
}

// The three roles that get case studies. Apollyon leads: it is current, and the
// only one where the whole stack from schema to TLS was a single person's call.
const featured = ['apollyon', 'personally-ai', 'atonga']
  .map((id) => roles.find((role) => role.id === id)!)
  .filter(Boolean);

const [lead, ...rest] = featured;

const stackLabels: Record<(typeof skills)[number]['key'], string> = {
  languages: t('stack.languages'),
  backend: t('stack.backend'),
  infra: t('stack.infra'),
  data: t('stack.data'),
};
---

<Base locale={locale} path="/" title={t('site.name')} description={t('site.description')}>
  <section class="hero">
    <div class="shell">
      <p class="overline">{t('site.role')} &middot; {contact.location[locale]}</p>
      <h1>{t('home.lead')}</h1>
      <div class="intro">
        <p>{t('home.intro.a')}</p>
        <p>{t('home.intro.b')}</p>
        <p>{t('home.intro.c')}</p>
      </div>
      <p class="actions">
        <a class="btn btn-primary" href={localePath(locale, '/work')}>
          {t('home.allwork')}
          <Icon name="arrow-right" size={16} />
        </a>
        <a class="btn btn-secondary" href={contact.github} rel="me noopener" target="_blank">
          <Icon name="github" size={16} />
          github.com/JsNcAr
          <Icon name="arrow-up-right" size={14} />
        </a>
      </p>
    </div>
  </section>

  <section class="now" aria-labelledby="now-heading">
    <div class="shell now-inner">
      <h2 class="overline" id="now-heading">{t('home.now')}</h2>
      <p><Icon name="server" size={18} />{t('home.now.body')}</p>
    </div>
  </section>

  <section class="work" aria-labelledby="work-heading">
    <div class="shell">
      <div class="section-head">
        <h2 id="work-heading">{t('home.selected')}</h2>
        <p>{t('home.selected.note')}</p>
      </div>

      <CaseCard
        lead
        href={localePath(locale, `/work/${lead.id}`)}
        org={lead.org}
        title={lead.title}
        period={period(lead.start, lead.end)}
        summary={lead.summary[locale]}
        stack={lead.stack}
        cta={t('home.more')}
      />

      <div class="pair">
        {rest.map((role) => (
          <CaseCard
            href={localePath(locale, `/work/${role.id}`)}
            org={role.org}
            title={role.title}
            period={period(role.start, role.end)}
            summary={role.summary[locale]}
            stack={role.stack}
            cta={t('home.more')}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="stack-section" aria-labelledby="stack-heading">
    <div class="shell">
      <h2 id="stack-heading" class="overline">{t('stack.title')}</h2>
      <dl class="stack-grid">
        {skills.map((group) => (
          <div class="stack-row">
            <dt>{stackLabels[group.key]}</dt>
            <dd>
              <ul>
                {group.items.map((item) => <TechPill label={item} />)}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: var(--space-56) var(--space-48);
  }

  .hero h1 {
    /* Display type is a different size, not a bolder body: 2.5x body at minimum. */
    font-size: var(--text-5xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tighter);
    margin-block: var(--space-16) var(--space-28);
    max-inline-size: 16ch;
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--space-96) var(--space-64);
    }

    .hero h1 {
      font-size: var(--text-7xl);
    }
  }

  .intro {
    display: grid;
    gap: var(--space-16);
    max-inline-size: var(--measure-prose);
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
    margin-block-start: var(--space-32);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-block-size: var(--space-44);
    padding: var(--space-10) var(--space-20);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    border: var(--stroke-thin) solid transparent;
    min-inline-size: 0;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .btn-primary {
    background: var(--color-action-primary);
    color: var(--color-text-on-action);
  }

  .btn-primary:hover {
    background: var(--color-action-primary-hover);
  }

  .btn-primary:active {
    background: var(--color-action-primary-active);
  }

  /* Secondary is neutral: outline and dark text, never a coloured fill. */
  .btn-secondary {
    background: transparent;
    color: var(--color-text-primary);
    border-color: var(--color-border-strong);
    font-family: var(--font-mono);
  }

  .btn-secondary:hover {
    background: var(--color-action-secondary-hover);
  }

  .btn-secondary:active {
    background: var(--color-action-secondary-active);
  }

  .now {
    border-block: var(--stroke-hairline) solid var(--color-border-default);
    background: var(--color-surface-sunken);
  }

  .now-inner {
    padding-block: var(--space-24);
    display: grid;
    gap: var(--space-8);
  }

  .now-inner p {
    display: flex;
    align-items: flex-start;
    gap: var(--space-10);
    max-inline-size: var(--measure-prose);
    color: var(--color-text-secondary);
  }

  .now-inner p :global(svg) {
    margin-block-start: 0.15em;
    color: var(--color-text-accent);
  }

  .work {
    padding-block: var(--space-64);
  }

  .section-head {
    display: grid;
    gap: var(--space-6);
    margin-block-end: var(--space-28);
  }

  .section-head h2 {
    font-size: var(--text-2xl);
  }

  .section-head p {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
  }

  .pair {
    display: grid;
    gap: var(--space-20);
    margin-block-start: var(--space-20);
  }

  @media (min-width: 48rem) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .stack-section {
    padding-block-end: var(--space-32);
  }

  .stack-grid {
    display: grid;
    gap: var(--space-20);
    margin: var(--space-20) 0 0;
    padding-block-start: var(--space-20);
    border-block-start: var(--stroke-hairline) solid var(--color-border-default);
  }

  .stack-row {
    display: grid;
    gap: var(--space-8);
    min-inline-size: 0;
  }

  @media (min-width: 48rem) {
    .stack-row {
      grid-template-columns: 12rem minmax(0, 1fr);
      gap: var(--space-24);
      align-items: baseline;
    }
  }

  .stack-row dt {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  .stack-row dd {
    margin: 0;
    min-inline-size: 0;
  }

  .stack-row ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin: 0;
    min-inline-size: 0;
  }
</style>
