---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/PageHeader.astro';
import TechPill from '@components/TechPill.astro';
import Icon from '@components/Icon.astro';
import type { Locale } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import { repos, githubProfile, type RepoGroup } from '@data/repos';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const groups: Array<{ key: RepoGroup; label: string }> = [
  { key: 'backend', label: t('os.group.backend') },
  { key: 'data', label: t('os.group.data') },
  { key: 'numerical', label: t('os.group.numerical') },
];

const lead = repos.find((r) => r.lead)!;
const byGroup = (key: RepoGroup) => repos.filter((r) => r.group === key && !r.lead);
---

<Base locale={locale} path="/open-source" title={t('os.title')} description={t('os.intro')}>
  <PageHeader overline={t('os.title')} title={t('os.lead')} intro={t('os.intro')} />

  <div class="shell">
    <article class="repo lead">
      <div class="head">
        <h2>
          <a href={lead.url} rel="noopener" target="_blank">
            <span class="stretch"></span>{lead.name}
          </a>
        </h2>
        <p class="lang">{lead.language}</p>
      </div>
      <p class="blurb">{lead.blurb[locale]}</p>
      <ul class="pills">{lead.tags.map((tag) => <TechPill label={tag} />)}</ul>
      <p class="cta" aria-hidden="true">
        <span>{t('os.viewrepo')}</span>
        <Icon name="arrow-up-right" size={14} />
      </p>
    </article>

    {groups.map((group) => (
      <section class="group" aria-labelledby={`g-${group.key}`}>
        <h2 class="overline" id={`g-${group.key}`}>{group.label}</h2>
        <ul class="grid">
          {byGroup(group.key).map((repo) => (
            <li class="repo">
              <div class="head">
                <h3>
                  <a href={repo.url} rel="noopener" target="_blank">
                    <span class="stretch"></span>{repo.name}
                  </a>
                </h3>
                <p class="lang">{repo.language}</p>
              </div>
              <p class="blurb">{repo.blurb[locale]}</p>
              <ul class="pills">{repo.tags.map((tag) => <TechPill label={tag} />)}</ul>
              <p class="cta" aria-hidden="true">
                <span>{t('os.viewrepo')}</span>
                <Icon name="arrow-up-right" size={14} />
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <aside class="notes">
      <div class="note">
        <h2>{t('os.frontend.title')}</h2>
        <p>{t('os.frontend.body')}</p>
      </div>
      <div class="note">
        <h2>{t('os.coursework.title')}</h2>
        <p>{t('os.coursework.body')}</p>
      </div>
    </aside>

    <p class="profile">
      <a href={githubProfile.url} rel="me noopener" target="_blank">
        <Icon name="github" size={16} />
        {t('os.profile')}
        <Icon name="arrow-up-right" size={14} />
      </a>
    </p>
  </div>
</Base>

<style>
  .repo {
    position: relative;
    display: grid;
    gap: var(--space-10);
    align-content: start;
    padding: var(--space-24);
    background: var(--color-surface-card);
    border: var(--stroke-hairline) solid var(--color-border-default);
    border-radius: var(--radius-md);
    min-inline-size: 0;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .repo:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }

  .repo:has(a:focus-visible) {
    box-shadow: var(--shadow-focus-ring);
  }

  .lead {
    margin-block-start: var(--space-48);
    padding: var(--space-32);
    border-block-start: var(--stroke-rule) solid var(--color-action-primary);
  }

  .stretch {
    position: absolute;
    inset: 0;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-6) var(--space-12);
    min-inline-size: 0;
  }

  .repo h2,
  .repo h3 {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-normal);
    margin: 0;
    min-inline-size: 0;
  }

  .lead h2 {
    font-size: var(--text-2xl);
  }

  .repo a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .repo:hover a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .repo a:focus-visible {
    outline: none;
  }

  .lang {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
  }

  .blurb {
    color: var(--color-text-secondary);
    max-inline-size: var(--measure-prose);
  }

  .lead .blurb {
    font-size: var(--text-lg);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-4);
    min-inline-size: 0;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    margin-block-start: var(--space-8);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-link);
  }

  .group {
    margin-block-start: var(--space-48);
  }

  .grid {
    display: grid;
    gap: var(--space-16);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-16);
  }

  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .notes {
    display: grid;
    gap: var(--space-24);
    margin-block-start: var(--space-64);
    padding-block-start: var(--space-32);
    border-block-start: var(--stroke-hairline) solid var(--color-border-default);
  }

  @media (min-width: 48rem) {
    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-40);
    }
  }

  .note h2 {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  .note p {
    margin-block-start: var(--space-8);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    max-inline-size: var(--measure-prose);
  }

  .profile {
    margin-block-start: var(--space-40);
  }

  .profile a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-block-size: var(--space-44);
    font-weight: var(--weight-medium);
  }
</style>
