---
import Base from '@layouts/Base.astro';
import PageHeader from '@components/PageHeader.astro';
import TechPill from '@components/TechPill.astro';
import Icon from '@components/Icon.astro';
import { Picture } from 'astro:assets';
// Copied from JsNcAr/champions-metadesk-studio docs/images/calc.png at 6806db8.
import championsCalc from '@assets/project-champions-calc.png';
import type { Locale } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import { repos, githubProfile, type RepoGroup } from '@data/repos';
import { sourceCodeNode } from '@lib/seo';
import { localePath } from '@i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const groups: Array<{ key: RepoGroup; label: string }> = [
  { key: 'backend', label: t('os.group.backend') },
  { key: 'data', label: t('os.group.data') },
  { key: 'numerical', label: t('os.group.numerical') },
];

const lead = repos.find((r) => r.lead)!;

// Keyed by repo name, like the example-site shots on /services, so a lead
// without a screenshot simply renders without one.
const leadShots: Record<string, ImageMetadata | undefined> = {
  'champions-metadesk-studio': championsCalc,
};
const leadShot = leadShots[lead.name];

const pageUrl = new URL(localePath(locale, '/open-source'), Astro.site).href;
const leadCode = sourceCodeNode({
  origin: new URL(Astro.site!).origin,
  url: pageUrl,
  name: lead.name,
  description: lead.blurb[locale],
  repository: lead.url,
  language: lead.language,
  ...(lead.license ? { license: lead.license } : {}),
});
// widths/sizes below are measured, not guessed: the lead image renders 310-650px
// wide in one column and caps at 942px, the shell's measure.
const byGroup = (key: RepoGroup) => repos.filter((r) => r.group === key && !r.lead);

/**
 * Repository names are long snake_case and kebab-case strings. The page-wide
 * `overflow-wrap: anywhere` keeps them from setting the min-content width, but
 * with no break opportunity it splits them mid-syllable
 * ("Metodos1_JasonArias_SergioCru | z"). Offering <wbr> after each separator
 * gives the browser somewhere sensible to break first.
 */
function breakable(name: string): string[] {
  return name.split(/(?<=[_-])/);
}
---

<Base locale={locale} path="/open-source" title={t('meta.opensource.title')} description={t('meta.opensource.description')} extraNodes={[leadCode]}>
  <PageHeader overline={t('os.title')} title={t('os.lead')} intro={t('os.intro')} />

  <div class="shell">
    <article class="repo lead">
      {leadShot && (
        <Picture
          src={leadShot}
          formats={['avif', 'webp']}
          fallbackFormat="png"
          widths={[480, 720, 960, 1440]}
          sizes="min(59rem, calc(100vw - 3rem))"
          alt={t('os.lead.shot')}
          loading="eager"
          decoding="async"
          class="shot"
        />
      )}
      <div class="lead-body">
      <div class="head">
        <h2>
          <a href={lead.url} rel="noopener" target="_blank">
            <span class="stretch"></span>{breakable(lead.name).map((part, i) => (
              <>{i > 0 && <wbr />}{part}</>
            ))}
          </a>
        </h2>
        <p class="lang">{lead.language}</p>
      </div>
      <p class="blurb">{lead.blurb[locale]}</p>
      <ul class="pills">{lead.tags.map((tag) => <TechPill label={tag} />)}</ul>
      <p class="cta" aria-hidden="true">
        <span>{t('os.viewrepo')}</span>
        <Icon name="arrow-up-right" size={14} />
      </p>
      </div>
    </article>

    {groups.map((group) => (
      <section class="group" aria-labelledby={`g-${group.key}`}>
        <h2 class="overline" id={`g-${group.key}`}>{group.label}</h2>
        <ul class="grid">
          {byGroup(group.key).map((repo, i) => (
            <li class:list={['repo', { first: i === 0 }]}>
              <div class="head">
                <h3>
                  <a href={repo.url} rel="noopener" target="_blank">
                    <span class="stretch"></span>{breakable(repo.name).map((part, i) => (
                      <>{i > 0 && <wbr />}{part}</>
                    ))}
                  </a>
                </h3>
                <p class="lang">{repo.language}</p>
              </div>
              <p class="blurb">{repo.blurb[locale]}</p>
              <ul class="pills">{repo.tags.map((tag) => <TechPill label={tag} />)}</ul>
              <p class="cta" aria-hidden="true">
                <span>{t('os.viewrepo')}</span>
                <Icon name="arrow-up-right" size={14} />
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <aside class="notes">
      <div class="note">
        <h2>{t('os.ai.title')}</h2>
        <p>{t('os.ai.body')}</p>
      </div>
      <div class="note">
        <h2>{t('os.coursework.title')}</h2>
        <p>{t('os.coursework.body')}</p>
      </div>
    </aside>

    <p class="profile">
      <a href={githubProfile.url} rel="me noopener" target="_blank">
        <Icon name="github" size={16} />
        {t('os.profile')}
        <Icon name="arrow-up-right" size={14} />
      </a>
    </p>
  </div>
</Base>

<style>
  .repo {
    position: relative;
    display: grid;
    gap: var(--space-10);
    align-content: start;
    padding: var(--space-24);
    background: var(--color-surface-card);
    border: var(--stroke-hairline) solid var(--color-border-default);
    border-radius: var(--radius-md);
    min-inline-size: 0;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .repo:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }

  .repo:has(a:focus-visible) {
    box-shadow: var(--shadow-focus-ring);
  }

  /* The screenshot runs to the card edge, so the padding moves to .lead-body
     and the radius is enforced by clipping. The focus ring is the card's own
     box-shadow, which overflow does not clip. */
  .lead {
    margin-block-start: var(--space-48);
    padding: 0;
    gap: 0;
    overflow: hidden;
    border-block-start: var(--stroke-rule) solid var(--color-action-primary);
  }

  .lead-body {
    display: grid;
    gap: var(--space-10);
    align-content: start;
    padding: var(--space-32);
    min-inline-size: 0;
  }

  /* Reserved by aspect-ratio so the card does not grow as the image decodes. */
  .shot {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1440 / 900;
    object-fit: cover;
    border-block-end: var(--stroke-hairline) solid var(--color-border-default);
  }

  .stretch {
    position: absolute;
    inset: 0;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-6) var(--space-12);
    min-inline-size: 0;
  }

  .repo h2,
  .repo h3 {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-normal);
    margin: 0;
    min-inline-size: 0;
  }

  .lead h2 {
    font-size: var(--text-2xl);
  }

  .repo a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .repo:hover a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .repo a:focus-visible {
    outline: none;
  }

  .lang {
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text-tertiary);
  }

  .blurb {
    color: var(--color-text-secondary);
    max-inline-size: var(--measure-prose);
  }

  .lead .blurb {
    font-size: var(--text-lg);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-4);
    min-inline-size: 0;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    margin-block-start: var(--space-8);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-link);
  }

  .group {
    margin-block-start: var(--space-48);
  }

  .grid {
    display: grid;
    gap: var(--space-16);
    list-style: none;
    padding: 0;
    margin-block-start: var(--space-16);
  }

  /* Six equal cards read as a generated grid. The first repository in each
     group takes the wider track, so the eye has somewhere to land. */
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    /* Wide, narrow, then full width. A third card left alone in a 2/5 track
       reads as a gap rather than as a deliberate row. */
    .grid > .repo {
      grid-column: span 5;
    }

    .grid > .repo:first-child {
      grid-column: span 3;
    }

    .grid > .repo:nth-child(2) {
      grid-column: span 2;
    }
  }

  .notes {
    display: grid;
    gap: var(--space-24);
    margin-block-start: var(--space-64);
    padding-block-start: var(--space-32);
    border-block-start: var(--stroke-hairline) solid var(--color-border-default);
  }

  @media (min-width: 48rem) {
    .notes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-40);
    }
  }

  .note h2 {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
  }

  .note p {
    margin-block-start: var(--space-8);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    max-inline-size: var(--measure-prose);
  }

  .profile {
    margin-block: var(--space-40) var(--space-80);
  }

  .profile a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-block-size: var(--space-44);
    font-weight: var(--weight-medium);
  }
</style>
