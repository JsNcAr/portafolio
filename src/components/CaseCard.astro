---
import Icon from './Icon.astro';
import TechPill from './TechPill.astro';

interface Props {
  href: string;
  org: string;
  title: string;
  period: string;
  summary: string;
  stack: string[];
  cta: string;
  /** The lead card carries more weight and sits on its own row. */
  lead?: boolean;
}

const { href, org, title, period, summary, stack, cta, lead = false } = Astro.props;
---

<article class:list={['case', { lead }]}>
  <p class="overline period">{period}</p>
  <h3 class="org">
    <a href={href}>
      <span class="stretch"></span>{org}
    </a>
  </h3>
  <p class="role">{title}</p>
  <p class="summary">{summary}</p>
  <ul class="pills">
    {stack.map((item) => <TechPill label={item} />)}
  </ul>
  <p class="cta" aria-hidden="true">
    <span>{cta}</span>
    <Icon name="arrow-right" size={16} />
  </p>
</article>

<style>
  .case {
    position: relative;
    display: grid;
    gap: var(--space-10);
    align-content: start;
    padding: var(--space-24);
    background: var(--color-surface-card);
    border: var(--stroke-hairline) solid var(--color-border-default);
    border-radius: var(--radius-md);
    /* A grid item keeps min-width:auto and would widen its own track. */
    min-inline-size: 0;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .case:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }

  /* The whole card is the target; the link itself stays the accessible name. */
  .stretch {
    position: absolute;
    inset: 0;
  }

  .org {
    font-size: var(--text-xl);
    margin: 0;
  }

  .org a {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .case:hover .org a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .org a:focus-visible {
    outline: none;
  }

  /* With a stretched link the ring belongs on the card, not on the text. */
  .case:has(a:focus-visible) {
    box-shadow: var(--shadow-focus-ring);
  }

  .role {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-accent);
  }

  .summary {
    color: var(--color-text-secondary);
    max-inline-size: var(--measure-prose);
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin: var(--space-4) 0 0;
    min-inline-size: 0;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    margin-block-start: var(--space-8);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-link);
  }

  .cta :global(svg) {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .case:hover .cta :global(svg) {
    transform: translateX(3px);
  }

  /* The lead case gets size and a heavier rule; the rest stay quiet. */
  .lead {
    padding: var(--space-32);
    border-block-start: var(--stroke-rule) solid var(--color-action-primary);
  }

  .lead .org {
    font-size: var(--text-3xl);
  }

  .lead .summary {
    font-size: var(--text-lg);
  }

  @media (min-width: 48rem) {
    .lead .org {
      font-size: var(--text-4xl);
    }
  }
</style>
