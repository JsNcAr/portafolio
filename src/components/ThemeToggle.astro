---
import Icon from './Icon.astro';

/**
 * Three-state in effect: no stored value follows the OS, and an explicit choice
 * stamps data-theme on <html>. Rendered as a button, not a checkbox, because it
 * performs an action rather than representing a persistent selection.
 */
---

<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
  <span class="icon icon-sun"><Icon name="sun" size={16} /></span>
  <span class="icon icon-moon"><Icon name="moon" size={16} /></span>
  <span class="label" data-theme-label>Dark</span>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = document.querySelector<HTMLElement>('[data-theme-label]');

  const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

  function currentlyDark(): boolean {
    const explicit = root.getAttribute('data-theme');
    if (explicit === 'dark') return true;
    if (explicit === 'light') return false;
    return prefersDark.matches;
  }

  function paint() {
    if (!button || !label) return;
    const dark = currentlyDark();
    button.setAttribute('aria-pressed', String(dark));
    // The label names the current mode, and aria-pressed carries the on/off state.
    label.textContent = dark ? 'Dark' : 'Light';
    button.dataset.mode = dark ? 'dark' : 'light';
  }

  button?.addEventListener('click', () => {
    const next = currentlyDark() ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* Storage blocked: the choice still applies for this page view. */
    }
    paint();
  });

  // Follow the OS while the reader has made no explicit choice.
  prefersDark.addEventListener('change', () => {
    if (!root.hasAttribute('data-theme')) paint();
  });

  paint();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-10);
    min-block-size: var(--space-36);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    background: transparent;
    border: var(--stroke-thin) solid var(--color-border-default);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    background: var(--color-action-secondary-hover);
    border-color: var(--color-border-strong);
    color: var(--color-text-primary);
  }

  .theme-toggle:active {
    background: var(--color-action-secondary-active);
  }

  /* Show the icon for the mode currently in effect. */
  .icon-moon {
    display: none;
  }

  .theme-toggle[data-mode='dark'] .icon-moon {
    display: inline-flex;
  }

  .theme-toggle[data-mode='dark'] .icon-sun {
    display: none;
  }

  .icon {
    display: inline-flex;
  }
</style>
