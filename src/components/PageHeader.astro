---
interface Props {
  overline: string;
  title: string;
  intro?: string;
}

const { overline, title, intro } = Astro.props;
---

<header class="page-header">
  <div class="shell">
    <p class="overline">{overline}</p>
    <h1>{title}</h1>
    {intro && <p class="intro">{intro}</p>}
  </div>
</header>

<style>
  .page-header {
    padding-block: var(--space-56) var(--space-40);
    border-block-end: var(--stroke-hairline) solid var(--color-border-default);
  }

  h1 {
    font-size: var(--text-4xl);
    letter-spacing: var(--tracking-tighter);
    margin-block: var(--space-12) 0;
    max-inline-size: 24ch;
  }

  @media (min-width: 48rem) {
    .page-header {
      padding-block: var(--space-80) var(--space-48);
    }

    h1 {
      font-size: var(--text-5xl);
    }
  }

  .intro {
    margin-block-start: var(--space-20);
    max-inline-size: var(--measure-prose);
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }
</style>
