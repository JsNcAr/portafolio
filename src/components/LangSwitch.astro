---
import Icon from './Icon.astro';
import { LOCALE_NAME, HTML_LANG, type Locale } from '@i18n/ui';
import { useTranslations, localePath, otherLocale } from '@i18n/utils';

interface Props {
  locale: Locale;
  /** Canonical English-rooted path, so the switch lands on the same page. */
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const target = otherLocale(locale);
---

<a
  class="lang"
  href={localePath(target, path)}
  hreflang={HTML_LANG[target]}
  lang={HTML_LANG[target]}
  rel="alternate"
>
  <Icon name="languages" size={16} />
  <span>{LOCALE_NAME[target]}</span>
  <span class="sr-only">{t('lang.switch')}</span>
</a>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    /* 24px minimum target (WCAG 2.5.8) comes from the block padding + line box. */
    padding: var(--space-6) var(--space-10);
    min-block-size: var(--space-36);
    border: var(--stroke-thin) solid var(--color-border-default);
    border-radius: var(--radius-md);
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    background: transparent;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .lang:hover {
    background: var(--color-action-secondary-hover);
    border-color: var(--color-border-strong);
    color: var(--color-text-primary);
  }

  .lang:active {
    background: var(--color-action-secondary-active);
  }
</style>
