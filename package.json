{
  "name": "jasonarias-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal portfolio site for Jason Nicolas Arias Gomez. Static Astro build, served by Caddy.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "tokens": "node scripts/build-theme.mjs",
    "shot": "node scripts/shot.mjs",
    "gate:browser": "node scripts/check-browser.mjs",
    "gate:tokens": "python3 ../../scripts/validate_tokens.py design-tokens.json",
    "gate:contrast": "python3 ../../scripts/validate_contrast.py design-tokens.json",
    "gate:emoji": "python3 ../../scripts/check_no_emoji.py",
    "gate:static": "npm run gate:tokens && npm run gate:contrast && npm run gate:emoji",
    "gate:render": "npm run gate:browser && npm run gate:prepare && node scripts/run-render-gates.mjs",
    "gate": "npm run build && npm run gate:static && npm run gate:render",
    "gate:prepare": "node scripts/prepare-gate-site.mjs",
    "serve": "node scripts/serve-local.mjs",
    "serve:build": "npm run build && node scripts/serve-local.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.2.9"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
